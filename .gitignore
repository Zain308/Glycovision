# Top-level ignores for the GlycoVision workspace.
# glycovision-app/ and glycovision-backend/ have their own .gitignore files.

# Local copies kept out of git
_archive/
_backups/

# Training dataset (407 MB): too large for git; keep on disk or in storage.
HUPA-UCM Diabetes Dataset/

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Food photo dataset (gigabytes): keep on disk or Kaggle, never in git.
food-dataset/
food-dataset-near-duplicates/
downloads/
kaggle-upload/

# Built deploy bundles (backend Space copy with 1.3 GB of models)
deploy/

# Local build tools (eas-cli lives here, not in the app)
tools/
