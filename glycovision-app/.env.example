# GlycoVision app configuration.
# Copy this file to .env and fill in the values. Never commit .env.
# Restart Expo with `npx expo start -c` after changing these.

# Backend address. During development use your PC's Wi-Fi IP
# (run `ipconfig` on Windows) and port 8000, e.g. http://192.168.1.10:8000.
EXPO_PUBLIC_API_URL=

# Supabase project (Project Settings > API).
# Use the anon (public) key here, never the service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
