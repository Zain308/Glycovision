# GlycoVision backend configuration.
# Copy this file to .env and fill in the values. Never commit .env.

# --- Supabase (Project Settings > API) ---------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
# Service-role key: full database access. Server only, never in the app.
SUPABASE_SERVICE_ROLE_KEY=

# --- Nutrition lookup (https://calorieninjas.com/api) -------------------
CALORIENINJAS_API_KEY=

# --- Food recognition fallback (local Ollama) ---------------------------
# Used only when the main classifier is unsure. Set to false on servers
# that don't run Ollama.
USE_OLLAMA_FALLBACK=true
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=moondream

# --- Audio (voice check) ------------------------------------------------
# Full paths to ffmpeg and ffprobe. Leave empty if they are on PATH.
# Windows example: C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=

# --- HTTP -------------------------------------------------------------------
# Browser origins allowed by CORS, comma-separated, or * for any.
CORS_ORIGINS=*

# --- Time -------------------------------------------------------------------
# IANA time zone used when a user's profile has none.
DEFAULT_TIMEZONE=Asia/Karachi

# --- Dev scripts only (scripts/) ---------------------------------------
# Supabase user ID that seed/check scripts write test data for.
SEED_USER_ID=
